{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // NestJS uses classic TypeScript decorators. No emitDecoratorMetadata:
    // every injected dependency is named with @Inject(...), so tsx and Vitest
    // (which cannot emit that metadata) behave exactly like the build.
    "experimentalDecorators": true
  },
  // prisma.config.ts is type-checked and linted, but not part of the build.
  "include": ["src", "prisma.config.ts"]
}
