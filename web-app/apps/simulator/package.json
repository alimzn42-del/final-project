{
  "name": "@mixline/simulator",
  "version": "0.0.0",
  "private": true,
  "description": "Publishes fake telemetry on the real MQTT topics until the hardware exists",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --conditions=source --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "check": "tsx --conditions=source --env-file-if-exists=../../.env src/check.ts"
  },
  "dependencies": {
    "@mixline/shared": "workspace:*",
    "mqtt": "^5.16.1",
    "zod": "^4.6.7"
  }
}
