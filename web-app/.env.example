# Copy this file to .env and replace every "change-me".
# .env is git-ignored: real passwords never go into the repo.

# PostgreSQL + TimescaleDB
POSTGRES_USER=mixline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mixline
POSTGRES_PORT=5432
# Prisma builds the database address from these values; host defaults to localhost
# (Docker services use POSTGRES_HOST=db, set in docker-compose.yml).

# Mosquitto MQTT broker
MQTT_USERNAME=mixline
MQTT_PASSWORD=change-me
MQTT_PORT=1883
# Apps running on this laptop (pnpm dev). Inside Docker, docker-compose.yml
# sets MQTT_URL=mqtt://mqtt:1883 for each service.
MQTT_URL=mqtt://localhost:1883

# The web app (nginx in Docker): open http://<this computer>:WEB_PORT in a browser.
# 8080 by default (port 80 is often taken on Windows); 80 is fine on the Raspberry Pi.
WEB_PORT=8080

# Backend (NestJS). MACHINE_CONFIG and LOCALES_DIR default to the repo's config/.
PORT=3000
# Charts use the time a reading was received when the device clock is further off
# than this, in milliseconds (owner: 2000).
CLOCK_TOLERANCE_MS=2000

# Login sessions (backend). JWT_SECRET: at least 32 random characters, never shared.
JWT_SECRET=change-me
SESSION_HOURS=8
# true only when the app is served over HTTPS (the lab network is plain HTTP).
COOKIE_SECURE=false

# First manager account, created at the first start if no manager exists.
# Changing these later has no effect on an existing account.
MANAGER_EMAIL=manager@mixline.local
MANAGER_PASSWORD=change-me
