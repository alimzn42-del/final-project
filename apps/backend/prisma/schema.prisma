// MixLine database (docs/04-architecture.md, "Database").
// Plain tables live here; the TimescaleDB parts (hypertable, compression,
// retention, 1-minute summary) are raw SQL in prisma/migrations, because
// Prisma cannot describe them. Connection settings: prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  manager
  worker
  customer
}

enum Locale {
  en
  ar
}

/// The 14 Syrian governorates, plus "outside" (then `country` is filled in).
enum Governorate {
  damascus
  rifDimashq
  aleppo
  homs
  hama
  latakia
  tartus
  idlib
  daraa
  asSuwayda
  quneitra
  deirEzZor
  raqqa
  hasakah
  outside
}

enum Source {
  sim
  hw
}

/// One table for all roles. The sign-up profile is required for customers
/// (checked by the sign-up validation) and empty for staff accounts.
/// Emails are stored lowercase (a database check refuses capitals).
model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  locale       Locale   @default(en)
  /// Null for self-signup and for the manager seeded from .env.
  createdById  String?  @map("created_by") @db.Uuid
  createdBy    User?    @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  created      User[]   @relation("CreatedBy")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Staff (owner, step 9).
  /// Workers only (database check "department if and only if worker"). The
  /// foreign key refuses to delete a department that still has workers.
  departmentId       String?     @map("department_id") @db.Uuid
  department         Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  /// True for accounts a manager creates, until the temporary password is changed.
  mustChangePassword Boolean     @default(false) @map("must_change_password")

  // Sign-up profile (customers).
  fullName     String?      @map("full_name")
  /// E.164, e.g. +963912345678.
  mobile       String?
  dateOfBirth  DateTime?    @map("date_of_birth") @db.Date
  governorate  Governorate?
  /// Only when governorate is "outside".
  country      String?
  cityArea     String?      @map("city_area")
  occupation   String?
  paintPurpose String?      @map("paint_purpose")

  sessions Session[]

  @@map("users")
}

/// One row per login (owner, step 11). The session token names its row, and
/// every request checks that the row still exists: logout deletes it, so a
/// copied token stops working at once. A password change deletes the user's
/// other rows. Rows of a deleted user go with it (ON DELETE CASCADE).
model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

/// Worker departments (owner, step 9), managed by managers. Maintenance,
/// Production and Quality are inserted once, by the migration that creates the
/// table, so deleting them later never brings them back. A department that
/// still has workers cannot be deleted (foreign key on users.department_id).
model Department {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nameEn    String   @unique @map("name_en")
  nameAr    String   @unique @map("name_ar")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  workers   User[]

  @@map("departments")
}

/// Sensor readings, a TimescaleDB hypertable partitioned on received_at (see
/// the timescale migration). Kept out of the generated client (@@ignore):
/// Prisma needs a unique key per row and a stream of readings has none.
/// The backend writes and reads it with SQL (step 9). Listing it here keeps
/// Prisma from ever treating the table as unknown and dropping it.
model Telemetry {
  /// Set by the backend when the message arrives: never depends on a device clock.
  receivedAt DateTime @map("received_at") @db.Timestamptz(3)
  /// The device's own timestamp (`ts` in the MQTT payload); may be off.
  deviceTs   DateTime @map("device_ts") @db.Timestamptz(3)
  sensorId   String   @map("sensor_id")
  value      Float
  source     Source

  /// Charts read one sensor over a time range.
  @@index([sensorId, receivedAt(sort: Desc)], map: "telemetry_sensor_time_idx")
  @@map("telemetry")
  @@ignore
}
