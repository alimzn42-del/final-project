{
  "name": "@mixline/backend",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API: auth, machine config, MQTT ingest, telemetry storage, WebSocket push",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --conditions=source --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@mixline/shared": "workspace:*",
    "@nestjs/common": "~12.1.3",
    "@nestjs/core": "~12.1.3",
    "@nestjs/platform-express": "~12.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "~12.1.3",
    "prisma": "7.10.1"
  }
}
