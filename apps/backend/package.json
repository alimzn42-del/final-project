{
  "name": "@mixline/backend",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API: auth, machine config, MQTT ingest, telemetry storage, WebSocket push",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc --noEmit",
    "dev": "tsx watch --conditions=source --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev && prisma generate",
    "db:status": "prisma migrate status",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@mixline/shared": "workspace:*",
    "@nestjs/common": "~12.1.3",
    "@nestjs/core": "~12.1.3",
    "@nestjs/platform-express": "~12.1.3",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "jose": "^6.2.13",
    "mqtt": "^5.16.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "~12.1.3",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1"
  }
}
