{
  "name": "mixline",
  "version": "0.0.0",
  "private": true,
  "description": "MixLine digital twin web app (ALMAS graduation project)",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "infra:up": "docker compose up -d --wait db mqtt",
    "infra:down": "docker compose down",
    "infra:check": "node scripts/check-infra.mjs",
    "sim:check": "pnpm --filter @mixline/simulator check",
    "stack:up": "docker compose up -d --build --wait",
    "stack:down": "docker compose down",
    "db:migrate": "pnpm --filter @mixline/backend db:migrate",
    "db:check": "node scripts/check-db.mjs",
    "test:db": "vitest run --config vitest.db.config.ts",
    "telemetry:check": "node scripts/check-telemetry.mjs",
    "live:check": "node scripts/check-live.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
