{
  "name": "mixline",
  "version": "0.0.0",
  "private": true,
  "description": "MixLine digital twin web app (ALMAS graduation project)",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "infra:up": "docker compose up -d --wait db mqtt",
    "infra:down": "docker compose down",
    "infra:check": "node scripts/check-infra.mjs",
    "sim:check": "pnpm --filter @mixline/simulator check",
    "stack:up": "docker compose up -d --build --wait",
    "stack:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
