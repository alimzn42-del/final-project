# Copy this file to .env and replace every "change-me".
# .env is git-ignored: real passwords never go into the repo.

# PostgreSQL + TimescaleDB
POSTGRES_USER=mixline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mixline
POSTGRES_PORT=5432
# Prisma builds the database address from these values; host defaults to localhost
# (Docker services use POSTGRES_HOST=db, set in docker-compose.yml).

# Mosquitto MQTT broker
MQTT_USERNAME=mixline
MQTT_PASSWORD=change-me
MQTT_PORT=1883
# Apps running on this laptop (pnpm dev). Inside Docker, docker-compose.yml
# sets MQTT_URL=mqtt://mqtt:1883 for each service.
MQTT_URL=mqtt://localhost:1883

# Backend (NestJS). MACHINE_CONFIG and LOCALES_DIR default to the repo's config/.
PORT=3000
