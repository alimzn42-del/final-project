# Copy this file to .env and replace every "change-me".
# .env is git-ignored: real passwords never go into the repo.

# PostgreSQL + TimescaleDB
POSTGRES_USER=mixline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mixline
POSTGRES_PORT=5432

# Mosquitto MQTT broker
MQTT_USERNAME=mixline
MQTT_PASSWORD=change-me
MQTT_PORT=1883
